---
import "../../static/style.scss";
import type { Language } from "../lib/languages";
import { site, siteUrl } from "../lib/site";

interface Props {
  language: Language;
  pageTitle?: string;
  canonicalPath: string;
  alternateLanguages: Language[];
  writingMode?: "horizontal" | "vertical";
  type?: "article" | "website";
  published?: string;
  description: string;
  feeds?: boolean;
}

const {
  language,
  pageTitle,
  canonicalPath,
  alternateLanguages,
  writingMode = language === "ja" || language === "ko-Kore"
    ? "vertical"
    : "horizontal",
  type = "website",
  published,
  description,
  feeds = false,
} = Astro.props;
const title =
  pageTitle == null
    ? site.titles[language]
    : `${pageTitle} — ${site.titles[language]}`;
const canonicalUrl = new URL(canonicalPath, siteUrl);
---

<!doctype html>
<html lang={language} class={writingMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle ?? site.titles[language]} />
    <meta property="og:site_name" content={site.titles[language]} />
    <meta property="og:locale" content={language.replaceAll("-", "_")} />
    {
      alternateLanguages
        .filter((alternate) => alternate !== language)
        .map((alternate) => (
          <meta
            property="og:locale:alternate"
            content={alternate.replaceAll("-", "_")}
          />
        ))
    }
    <meta property="og:type" content={type} />
    {
      published != null && (
        <meta property="article:published_time" content={published} />
      )
    }
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle ?? site.titles[language]} />
    <meta name="twitter:description" content={description} />
    {
      feeds &&
        alternateLanguages.map((alternate) => (
          <link
            rel="alternate"
            type="application/atom+xml"
            href={`/feed.${alternate.toLowerCase()}.xml`}
            hreflang={alternate}
            title={`Atom 1.0 (${site.languageNames[alternate]})`}
          />
        ))
    }
    {site.head != null && <Fragment set:html={site.head} />}
  </head>
  <body>
    <slot />
    <script>
      document
        .querySelectorAll<HTMLAnchorElement>("a[rel=alternate][hreflang]")
        .forEach((link) => {
          link.addEventListener("click", () => {
            const language = link.getAttribute("hreflang");
            if (language != null) {
              document.cookie = `accept-language=${encodeURIComponent(language)}; path=/; max-age=31536000; samesite=lax`;
            }
          });
        });
    </script>
  </body>
</html>
